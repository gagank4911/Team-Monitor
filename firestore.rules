rules_version = '2';

// Team Desk database rules.
// Paste into Firebase console > Firestore Database > Rules, then press Publish.
//
//   Everyone on the team (on the team list, with a verified @1cell.ai email) can SEE attendance, tasks, the roster,
//   settings and team bonding.
//   Each person can CHANGE only their own check-ins, their own tasks' status, and their own
//   leave/WFH requests. Everyone on the team can see leave/WFH requests and decisions (for the shared calendar).
//   Check-in locations are visible only to that person and managers.
//   Managers (admins) can approve leave, assign tasks, change settings and plan team bonding.
//
//   The team and everyone's role live in the database (members/{email}) and are managed in the
//   app's Team tab. Adding people or changing roles needs no change here.
//
// >>> owners() are the admins: always managers, can never be locked out, and may use any email
//     (not only @1cell.ai). Keep identical to "owners" in config.js. <<<
service cloud.firestore {
  match /databases/{database}/documents {

    function owners() {
      return ['gagank4911@gmail.com'];
    }

    function myEmail() { return request.auth.token.email.lower(); }

    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (myEmail().matches('.*@1cell[.]ai$') || myEmail() in owners());
    }

    function memberPath() { return /databases/$(database)/documents/members/$(myEmail()); }
    function isOwner() { return verified() && myEmail() in owners(); }
    function isMember() { return verified() && exists(memberPath()); }

    // Anyone on the team (owners count even before the team list exists)
    function isTeam() { return isOwner() || isMember(); }

    function isAdmin() { return isOwner() || (isMember() && get(memberPath()).data.role == 'manager'); }

    // true when person id `pid` belongs to the signed-in person
    function isMe(pid) { return isMember() && get(memberPath()).data.id == pid; }

    // The team list: who can sign in, their person id and role. Only managers change it.
    match /members/{email} {
      allow get: if verified() && (email == myEmail() || isTeam());
      allow list: if isTeam();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && !(email in owners());
    }

    // Roster
    match /people/{pid} {
      allow read: if isTeam();
      allow write: if isAdmin() || isMe(pid);

      // Check-in / check-out, one document per day
      match /attendance/{day} {
        allow read: if isTeam();
        allow write: if isAdmin() || isMe(pid);
      }

      // Where they checked in / out from, one document per day. Private: only the person and managers.
      match /geo/{day} {
        allow read: if isAdmin() || isMe(pid);
        allow write: if isAdmin() || isMe(pid);
      }

      // Tasks assigned to this person
      match /tasks/{tid} {
        allow read: if isTeam();
        allow create: if isAdmin() || (isMe(pid) && request.resource.data.createdBy == pid);
        allow update: if isAdmin() || isMe(pid);
        allow delete: if isAdmin() || (isMe(pid) && resource.data.createdBy == pid);
      }
    }

    // Leave and WFH requests: the whole team can see them (shared calendar); only the person and managers change them
    match /leave/{pid}/requests/{rid} {
      allow read: if isTeam();
      allow write: if isAdmin() || isMe(pid);
    }

    // Manager decisions on requests: the whole team can see them (so the calendar knows what is approved)
    match /approvals/{pid}/items/{iid} {
      allow read: if isTeam();
      allow write: if isAdmin();
    }

    // Anonymous "someone is away that day" markers for the daily limit
    match /holds/{hid} {
      allow read, write: if isTeam();
    }

    // Team settings (leave allowance, hours, Saturday groups, display names)
    match /settings/{doc} {
      allow read: if isTeam();
      allow write: if isAdmin();
    }

    match /invites/{doc} {
      allow read, write: if isAdmin();
    }

    // Team bonding activities
    match /events/{eid} {
      allow read: if isTeam();
      allow write: if isAdmin();
    }
  }
}
